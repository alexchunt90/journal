{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadAndWriteTheDocuments",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::alexchunt-journal/journal/*"
    },
    {
      "Sid": "ListBucketSoAbsentObjectsRead404",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::alexchunt-journal"
    }
  ]
}
